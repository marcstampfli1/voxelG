From 94d1048c2535513e80e42f6921f9eff11c69d32d Mon Sep 17 00:00:00 2001
From: mstampfli <marc.kurt.stampfli@icloud.com>
Date: Thu, 23 Jul 2026 00:00:46 +0200
Subject: [PATCH] Reuse acceleration-structure build scratch buffers across
 builds

build_acceleration_structures allocated a fresh scratch buffer per call and
freed it when the submission retired. Scratch is proportional to the geometry
being built, so applications that rebuild large acceleration structures every
frame (streaming worlds, dynamic scenes) paid a large allocate/free per build.

Park the most recent scratch buffer on the device instead: ScratchBuffer::new
takes it when it is large enough, and ScratchBuffer::drop returns it, keeping
the larger of the parked and returned buffer. A ScratchBuffer only drops once
its submission retired (it rides TempResource) or before it was ever submitted,
so a parked buffer is always GPU-idle and reuse needs no extra synchronization.
The cache stores the raw hal buffer only (no Arc<Device>), avoiding a device
reference cycle; the device destroys a parked buffer in its own Drop.

Rebuilding a ~300k-primitive AABB BLAS per streaming update dropped from
12-28 ms to 1.2-2 ms of CPU per call on Vulkan/NVIDIA.
---
 CHANGELOG.md                     |  6 +++
 wgpu-core/src/device/resource.rs | 13 +++++++
 wgpu-core/src/lock/rank.rs       |  6 +++
 wgpu-core/src/scratch.rs         | 65 +++++++++++++++++++++++++++++++-
 4 files changed, 88 insertions(+), 2 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index dbe3d80ce..b9e184638 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -101,6 +101,12 @@ Bottom level categories:
 
 - Fixed signed integer `%` (and `%=`) returning the wrong result for negative operands in the GLSL (OpenGL/GLES) backend, e.g. `-1 % 768` yielding `255` instead of `-1`. GLSL's `%` is undefined when either operand is negative, so signed remainder is now lowered as `a - b * (a / b)`, matching the SPIR-V, HLSL, and Metal backends. By @mstampfli in [#9687](https://github.com/gfx-rs/wgpu/pull/9687).
 
+### Performance
+
+#### General
+
+- Reuse the acceleration-structure build scratch buffer across `build_acceleration_structures` calls: the most recent scratch is parked on the device and taken by the next build that fits, instead of allocating and freeing a fresh buffer every build. Rebuilding a ~300k-primitive AABB BLAS every streaming update dropped from 12-28 ms to 1.2-2 ms of CPU per call. By @mstampfli in [#0000](https://github.com/gfx-rs/wgpu/pull/0000).
+
 ### Dependency Updates
 
 #### General
diff --git a/wgpu-core/src/device/resource.rs b/wgpu-core/src/device/resource.rs
index efc77fe94..5af84b492 100644
--- a/wgpu-core/src/device/resource.rs
+++ b/wgpu-core/src/device/resource.rs
@@ -291,6 +291,12 @@ pub struct Device {
     pub(crate) ordered_texture_usages: wgt::TextureUses,
     pub(crate) instance_flags: wgt::InstanceFlags,
     pub(crate) deferred_destroy: Mutex<Vec<DeferredDestroy>>,
+    /// The most recent acceleration-structure build scratch buffer, parked here
+    /// by [`ScratchBuffer::drop`] for reuse by the next build (largest kept).
+    /// Holds no `Arc<Device>` (no cycle); destroyed in [`Device`]'s `Drop`.
+    ///
+    /// [`ScratchBuffer::drop`]: crate::scratch::ScratchBuffer
+    pub(crate) scratch_buffer_cache: Mutex<Option<crate::scratch::CachedScratchBuffer>>,
     /// This closures were created in [`Buffer::drop`] where we do not run them to prevent locking problems.
     pub(crate) deferred_buffer_map_pending_closures: DeferredBufferMapPendingClosures,
     pub(crate) usage_scopes: UsageScopePool,
@@ -348,7 +354,13 @@ impl Drop for Device {
         if let Some(timestamp_normalizer) = self.timestamp_normalizer.take() {
             timestamp_normalizer.dispose(self.raw.as_ref());
         }
+        // Any parked acceleration-structure scratch buffer is idle by
+        // construction (parked only at submission retirement or pre-submit).
+        let cached_scratch = self.scratch_buffer_cache.lock().take();
         unsafe {
+            if let Some(cached) = cached_scratch {
+                self.raw.destroy_buffer(cached.raw);
+            }
             self.raw.destroy_buffer(zero_buffer);
             self.raw.destroy_bind_group_layout(empty_bgl);
             self.raw
@@ -595,6 +607,7 @@ impl Device {
             ordered_texture_usages,
             instance_flags,
             deferred_destroy: Mutex::new(rank::DEVICE_DEFERRED_DESTROY, Vec::new()),
+            scratch_buffer_cache: Mutex::new(rank::DEVICE_SCRATCH_BUFFER_CACHE, None),
             usage_scopes: Mutex::new(rank::DEVICE_USAGE_SCOPES, Default::default()),
             timestamp_normalizer: OnceCellOrLock::new(),
             indirect_validation,
